<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bold Clay Studio  &amp; Build</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Archivo:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#0A1A18;
    --pine:#122824;
    --emerald:#16332C;
    --brass:#B8935A;
    --brass-light:#D9B98B;
    --sand:#D9CBB0;
    --ivory:#F4EFE4;
    --glass: rgba(244,239,228,0.08);
    --max: 1180px;
    --ease: cubic-bezier(.22,.68,.16,1);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--ink);
    color:var(--ivory);
    font-family:'Archivo', sans-serif;
    font-weight:400;
    line-height:1.6;
    overflow-x:hidden;
  }
  h1,h2,h3,.serif{
    font-family:'Fraunces', serif;
    font-weight:500;
    letter-spacing:-0.01em;
  }
  a{color:inherit; text-decoration:none;}
  img{max-width:100%; display:block;}
  .wrap{max-width:var(--max); margin:0 auto; padding:0 40px;}
  ::selection{background:var(--brass); color:var(--ink);}

  /* ---------- NAV ---------- */
  header{
    position:fixed; top:0; left:0; right:0; z-index:100;
    padding:26px 0;
    transition: background .5s var(--ease), padding .4s var(--ease), border-color .5s var(--ease);
    border-bottom:1px solid transparent;
  }
  header.scrolled{
    background:rgba(10,26,24,0.86);
    backdrop-filter: blur(14px);
    padding:16px 0;
    border-color: rgba(217,203,176,0.12);
  }
  nav{display:flex; align-items:center; justify-content:space-between;}
  .logo{font-family:'Fraunces', serif; font-size:22px; font-weight:500; letter-spacing:0.01em;}
  .logo span{color:var(--brass-light);}
  .nav-links{display:flex; gap:38px; align-items:center;}
  .nav-links a{font-size:14.5px; color:var(--sand); position:relative; padding:4px 0;}
  .nav-links a:not(.cta)::after{
    content:''; position:absolute; left:0; bottom:0; width:0; height:1px; background:var(--brass-light);
    transition:width .35s var(--ease);
  }
  .nav-links a:not(.cta):hover::after{width:100%;}
  .nav-links a.cta{
    border:1px solid var(--brass); padding:9px 20px; border-radius:2px; color:var(--ivory);
    transition:background .3s var(--ease), color .3s var(--ease);
  }
  .nav-links a.cta:hover{background:var(--brass); color:var(--ink);}
  .nav-toggle{display:none; flex-direction:column; gap:5px; cursor:pointer; background:none; border:none;}
  .nav-toggle span{width:24px; height:1px; background:var(--ivory);}

  /* ---------- HERO / 3D ---------- */
  .hero{
    position:relative; height:100svh; min-height:640px; width:100%;
    display:flex; align-items:flex-end;
    overflow:hidden;
  }
  #scene-canvas{position:absolute; inset:0; width:100%; height:100%; display:block;}
  .hero::before{
    content:''; position:absolute; inset:0;
    background:linear-gradient(180deg, rgba(10,26,24,0.05) 0%, rgba(10,26,24,0.15) 55%, rgba(10,26,24,0.92) 100%);
    pointer-events:none; z-index:2;
  }
  .hero-content{
    position:relative; z-index:3; width:100%;
    padding:0 40px 90px;
  }
  .hero-inner{max-width:var(--max); margin:0 auto; display:grid; grid-template-columns:1.3fr 0.7fr; gap:40px; align-items:end;}
  .hero-eyebrow{
    color:var(--brass-light); font-size:14px; letter-spacing:0.02em; margin-bottom:18px;
    display:flex; align-items:center; gap:10px;
  }
  .hero-eyebrow .dot{width:6px; height:6px; border-radius:50%; background:var(--brass-light); display:inline-block;}
  h1.hero-title{
    font-size:clamp(40px, 6vw, 76px);
    line-height:1.03;
    font-weight:500;
    max-width:820px;
    color:var(--ivory);
  }
  .hero-side{font-size:16px; color:var(--sand); max-width:320px; padding-bottom:8px;}
  .hero-actions{display:flex; gap:16px; margin-top:34px; flex-wrap:wrap;}
  .btn{
    display:inline-flex; align-items:center; gap:10px;
    padding:15px 26px; font-size:14.5px; border-radius:2px; cursor:pointer;
    border:1px solid transparent; font-family:'Archivo', sans-serif;
  }
  .btn-solid{background:var(--brass); color:var(--ink);}
  .btn-solid:hover{background:var(--brass-light);}
  .btn-ghost{border-color:rgba(244,239,228,0.35); color:var(--ivory); background:transparent;}
  .btn-ghost:hover{border-color:var(--ivory);}
  .btn-tiny{font-size:13px; padding:9px 16px; border:1px solid rgba(244,239,228,0.3); border-radius:2px; background:transparent; color:var(--sand); cursor:pointer;}
  .btn-tiny:hover{border-color:var(--brass-light); color:var(--brass-light);}

  .scroll-cue{
    position:absolute; right:40px; bottom:36px; z-index:3;
    display:flex; flex-direction:column; align-items:center; gap:10px;
    color:var(--sand); font-size:12px;
  }
  .scroll-cue .line{width:1px; height:44px; background:rgba(244,239,228,0.35); position:relative; overflow:hidden;}
  .scroll-cue .line::after{
    content:''; position:absolute; top:-40%; left:0; width:100%; height:40%;
    background:var(--brass-light); animation:scrollmove 2.2s ease-in-out infinite;
  }
  @keyframes scrollmove{ 0%{top:-40%;} 100%{top:100%;} }

  /* ---------- SECTION GENERIC ---------- */
  section{position:relative; padding:120px 0;}
  .kicker{font-size:14px; color:var(--brass-light); margin-bottom:16px; font-family:'Archivo'; letter-spacing:0.01em;}
  .reveal{opacity:0; transform:translateY(28px); transition:opacity .9s var(--ease), transform .9s var(--ease);}
  .reveal.in-view{opacity:1; transform:translateY(0);}
  .reveal-stagger > *{opacity:0; transform:translateY(24px); transition:opacity .8s var(--ease), transform .8s var(--ease);}
  .reveal-stagger.in-view > *{opacity:1; transform:translateY(0);}
  .reveal-stagger.in-view > *:nth-child(1){transition-delay:.05s;}
  .reveal-stagger.in-view > *:nth-child(2){transition-delay:.16s;}
  .reveal-stagger.in-view > *:nth-child(3){transition-delay:.27s;}
  .reveal-stagger.in-view > *:nth-child(4){transition-delay:.38s;}

  /* ---------- PHILOSOPHY ---------- */
  .philosophy .wrap{display:grid; grid-template-columns:0.9fr 1.1fr; gap:60px;}
  .philosophy h2{font-size:clamp(28px,3.4vw,40px); max-width:360px; line-height:1.15;}
  .philosophy .lede{font-size:20px; color:var(--sand); font-family:'Fraunces'; font-weight:400; line-height:1.55; margin-bottom:26px;}
  .philosophy p.body{color:rgba(244,239,228,0.72); font-size:15.5px; max-width:520px;}
  .stat-row{display:flex; gap:56px; margin-top:44px; flex-wrap:wrap;}
  .stat-row .stat b{display:block; font-family:'Fraunces'; font-size:34px; color:var(--brass-light); font-weight:500;}
  .stat-row .stat span{font-size:13px; color:var(--sand); letter-spacing:0.01em;}

  /* ---------- PROCESS ---------- */
  .process{background:var(--pine);}
  .process-head{max-width:560px; margin-bottom:70px;}
  .process-head h2{font-size:clamp(28px,3.4vw,40px);}
  .process-list{display:grid; grid-template-columns:repeat(4,1fr); gap:1px; background:rgba(217,203,176,0.14); border-top:1px solid rgba(217,203,176,0.14); border-bottom:1px solid rgba(217,203,176,0.14);}
  .process-step{background:var(--pine); padding:36px 26px 40px; position:relative;}
  .process-step .num{font-family:'Fraunces'; font-size:15px; color:var(--brass-light); margin-bottom:26px; display:block;}
  .process-step h3{font-size:19px; margin-bottom:12px; font-weight:500;}
  .process-step p{font-size:14px; color:rgba(244,239,228,0.65);}

  /* ---------- COLLECTION ---------- */
  .collection-head{display:flex; justify-content:space-between; align-items:flex-end; gap:30px; margin-bottom:56px; flex-wrap:wrap;}
  .collection-head h2{font-size:clamp(28px,3.4vw,40px); max-width:460px;}
  .collection-head p{max-width:340px; color:rgba(244,239,228,0.65); font-size:15px;}
  .collection-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:2px;}
  .proj-card{position:relative; overflow:hidden; aspect-ratio:4/5; background:var(--emerald); cursor:pointer;}
  .proj-card img{width:100%; height:100%; object-fit:cover; transform:scale(1.04); transition:transform 1.1s var(--ease), filter .6s ease;}
  .proj-card:hover img{transform:scale(1.14);}
  .proj-card::after{content:''; position:absolute; inset:0; background:linear-gradient(0deg, rgba(10,26,24,0.88) 0%, rgba(10,26,24,0.05) 45%);}
  .proj-info{position:absolute; left:0; right:0; bottom:0; padding:28px; z-index:2;}
  .proj-info .region{font-size:12.5px; color:var(--brass-light); margin-bottom:6px;}
  .proj-info h3{font-size:23px; font-weight:500;}

  /* ---------- LOCATIONS ---------- */
  .locations{background:var(--emerald);}
  .loc-grid{display:grid; grid-template-columns:0.8fr 1.2fr; gap:60px; align-items:center;}
  .loc-grid h2{font-size:clamp(28px,3.4vw,40px); max-width:380px; margin-bottom:20px;}
  .loc-grid p{color:rgba(244,239,228,0.68); font-size:15px; max-width:420px;}
  .loc-list{border-top:1px solid rgba(217,203,176,0.18);}
  .loc-item{
    display:flex; justify-content:space-between; align-items:center;
    padding:22px 0; border-bottom:1px solid rgba(217,203,176,0.18);
    font-family:'Fraunces'; font-size:22px;
  }
  .loc-item span.count{font-family:'Archivo'; font-size:14px; color:var(--sand);}

  /* ---------- CTA / FOOTER ---------- */
  .cta-band{
    background:var(--brass); color:var(--ink); text-align:left;
    padding:110px 0;
  }
  .cta-band .wrap{display:flex; justify-content:space-between; align-items:flex-end; gap:30px; flex-wrap:wrap;}
  .cta-band h2{font-size:clamp(30px,4.4vw,54px); max-width:560px; color:var(--ink);}
  .cta-band .btn-solid{background:var(--ink); color:var(--ivory);}
  .cta-band .btn-solid:hover{background:#000;}

  footer{background:var(--ink); padding:70px 0 34px; border-top:1px solid rgba(217,203,176,0.12);}
  .footer-grid{display:grid; grid-template-columns:1.4fr 0.8fr 0.8fr 0.8fr; gap:40px; margin-bottom:60px;}
  .footer-grid h4{font-size:13px; color:var(--sand); margin-bottom:16px; font-weight:500;}
  .footer-grid a, .footer-grid p{font-size:14px; color:rgba(244,239,228,0.6); display:block; margin-bottom:10px;}
  .footer-grid a:hover{color:var(--brass-light);}
  .footer-bottom{display:flex; justify-content:space-between; padding-top:26px; border-top:1px solid rgba(217,203,176,0.12); font-size:12.5px; color:rgba(244,239,228,0.45); flex-wrap:wrap; gap:10px;}

  /* ---------- RESPONSIVE ---------- */
  @media (max-width:900px){
    .nav-links{position:fixed; top:0; right:0; height:100vh; width:78%; max-width:340px;
      background:var(--pine); flex-direction:column; justify-content:center; align-items:flex-start;
      padding:40px; gap:26px; transform:translateX(100%); transition:transform .5s var(--ease);}
    .nav-links.open{transform:translateX(0);}
    .nav-toggle{display:flex;}
    .hero-inner{grid-template-columns:1fr;}
    .hero-side{max-width:none;}
    .philosophy .wrap{grid-template-columns:1fr; gap:30px;}
    .process-list{grid-template-columns:1fr 1fr;}
    .collection-grid{grid-template-columns:1fr;}
    .loc-grid{grid-template-columns:1fr; gap:30px;}
    .footer-grid{grid-template-columns:1fr 1fr; gap:30px;}
  }
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.01ms !important; transition-duration:0.01ms !important;}
  }
</style>
</head>
<body>

<header id="siteHeader">
  <div class="wrap">
    <nav>
      <a href="#top" class="logo">Bold Clay <span>Studio</span></a>
      <div class="nav-links" id="navLinks">
        <a href="#philosophy">Philosophy</a>
        <a href="#process">Process</a>
        <a href="#collection">Collection</a>
        <a href="#locations">Locations</a>
        <a href="#contact" class="cta">Start a project</a>
      </div>
      <button class="nav-toggle" id="navToggle" aria-label="Menu"><span></span><span></span><span></span></button>
    </nav>
  </div>
</header>

<section class="hero" id="top">
  <canvas id="scene-canvas"></canvas>
  <div class="hero-content">
    <div class="hero-inner">
      <div>
        <div class="hero-eyebrow"><span class="dot"></span> Private resort design &amp; build studio</div>
        <h1 class="hero-title">We build stillness into paradise.</h1>
        <div class="hero-actions">
          <a href="#contact" class="btn btn-solid">Begin your resort</a>
          <button class="btn btn-tiny" id="replayBuild">Watch it rise again</button>
        </div>
      </div>
      <p class="hero-side">Bold Clay Studio and constructs private resorts on the world's quietest coastlines — from first site walk to opening day, with our own architects and our own builders.</p>
    </div>
  </div>
  <div class="scroll-cue"><span>Scroll</span><span class="line"></span></div>
</section>

<section class="philosophy" id="philosophy">
  <div class="wrap">
    <div>
      <div class="kicker">Philosophy</div>
      <h2>A resort should feel like it was always there.</h2>
    </div>
    <div class="reveal">
      <p class="lede">We don't decorate land. We listen to it — its light, its tide line, the way wind moves through it at four in the afternoon — and build only what that place was already asking for.</p>
      <p class="body">Every Marama project is led by the same small studio from concept sketch through to the final coat of limewash, and built by our own construction teams rather than handed to the lowest bidder. The result is architecture that reads as inevitable, not imposed — and a build process our clients can actually watch happen, stage by stage.</p>
      <div class="stat-row">
        <div class="stat"><b>38</b><span>Resorts completed</span></div>
        <div class="stat"><b>14</b><span>Countries</span></div>
        <div class="stat"><b>9 yrs</b><span>Average design–build time</span></div>
      </div>
    </div>
  </div>
</section>

<section class="process" id="process">
  <div class="wrap">
    <div class="process-head reveal">
      <div class="kicker">How a Marama resort gets built</div>
      <h2>Four stages, one continuous team.</h2>
    </div>
    <div class="process-list reveal-stagger" id="processList">
      <div class="process-step"><span class="num">01</span><h3>Site &amp; vision</h3><p>Weeks spent walking the land before a single line is drawn — mapping light, tide, wind and what the site wants to become.</p></div>
      <div class="process-step"><span class="num">02</span><h3>Design</h3><p>Architecture drawn from local material and topography, developed alongside engineers so nothing is redrawn later.</p></div>
      <div class="process-step"><span class="num">03</span><h3>Construction</h3><p>Built by Marama's own crews, using regional craft and materials sourced within a day's drive of the site.</p></div>
      <div class="process-step"><span class="num">04</span><h3>Unveiling</h3><p>The resort opens exactly as it was imagined — staffed, planted and operating before the first guest arrives.</p></div>
    </div>
  </div>
</section>

<section class="collection" id="collection">
  <div class="wrap">
    <div class="collection-head reveal">
      <h2>A small, recent collection.</h2>
      <p>A handful of resorts completed in the last few seasons — each shaped entirely by its own coastline.</p>
    </div>
    <div class="collection-grid reveal-stagger" id="collectionGrid">
      <div class="proj-card">
        <img src="https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=1000&q=80" alt="Villa with infinity pool overlooking the ocean" loading="lazy">
        <div class="proj-info"><div class="region">Andaman coast</div><h3>Vela Bay</h3></div>
      </div>
      <div class="proj-card">
        <img src="https://images.unsplash.com/photo-1540541338287-41700207dee6?auto=format&fit=crop&w=1000&q=80" alt="Modern resort building among palm trees" loading="lazy">
        <div class="proj-info"><div class="region">Southern Aegean</div><h3>Sable Point</h3></div>
      </div>
      <div class="proj-card">
        <img src="https://images.unsplash.com/photo-1533105079780-92b9be482077?auto=format&fit=crop&w=1000&q=80" alt="Tropical resort pool at dusk" loading="lazy">
        <div class="proj-info"><div class="region">Zanzibar archipelago</div><h3>Amber Reef</h3></div>
      </div>
      <div class="proj-card">
        <img src="https://images.unsplash.com/photo-1582610116397-edb318620f90?auto=format&fit=crop&w=1000&q=80" alt="Aerial view of resort on the coast" loading="lazy">
        <div class="proj-info"><div class="region">North Sulawesi</div><h3>North Cliff Cove</h3></div>
      </div>
    </div>
  </div>
</section>

<section class="locations" id="locations">
  <div class="wrap loc-grid">
    <div class="reveal">
      <div class="kicker">Where we build</div>
      <h2>Four regions, chosen slowly.</h2>
      <p>We open one or two sites a year, only where the land and the local trades can support the kind of building we do.</p>
    </div>
    <div class="loc-list reveal">
      <div class="loc-item"><span>Southeast Asia</span><span class="count">14 resorts</span></div>
      <div class="loc-item"><span>Mediterranean</span><span class="count">9 resorts</span></div>
      <div class="loc-item"><span>East Africa</span><span class="count">8 resorts</span></div>
      <div class="loc-item"><span>South Pacific</span><span class="count">7 resorts</span></div>
    </div>
  </div>
</section>

<section class="cta-band" id="contact">
  <div class="wrap reveal">
    <h2>Have a coastline in mind?</h2>
    <a href="mailto:studio@marama-resorts.com" class="btn btn-solid">studio@marama-resorts.com</a>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <h4>Marama</h4>
        <p style="max-width:280px;">A design–build studio for private resorts, working in four regions with one small team.</p>
      </div>
      <div>
        <h4>Studio</h4>
        <a href="#philosophy">Philosophy</a>
        <a href="#process">Process</a>
        <a href="#collection">Collection</a>
      </div>
      <div>
        <h4>Contact</h4>
        <a href="mailto:studio@marama-resorts.com">studio@Bold Clay Studio.com</a>
        <a href="tel:+18005551200">+1 800 555 1200</a>
      </div>
      <div>
        <h4>Follow</h4>
        <a href="#">Instagram</a>
        <a href="#">Journal</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026Bold Clay Studio. All rights reserved.</span>
      <span>Built stage by stage, like everything else we make.</span>
    </div>
  </div>
</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script>
/* ============ NAV ============ */
const header = document.getElementById('siteHeader');
window.addEventListener('scroll', () => {
  header.classList.toggle('scrolled', window.scrollY > 40);
});
const navToggle = document.getElementById('navToggle');
const navLinks = document.getElementById('navLinks');
navToggle.addEventListener('click', () => navLinks.classList.toggle('open'));
navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => navLinks.classList.remove('open')));

/* ============ SCROLL REVEAL ============ */
const revealEls = document.querySelectorAll('.reveal, .reveal-stagger');
const io = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('in-view');
      io.unobserve(entry.target);
    }
  });
}, { threshold: 0.18 });
revealEls.forEach(el => io.observe(el));

/* ============ 3D BUILD SCENE ============ */
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const canvas = document.getElementById('scene-canvas');
const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;

const scene = new THREE.Scene();

const camera = new THREE.PerspectiveCamera(38, window.innerWidth / window.innerHeight, 0.1, 200);
const camBase = new THREE.Vector3(15, 8.5, 17);
camera.position.copy(camBase);
camera.lookAt(0, 2.2, 0);

/* ---- sky gradient sphere ---- */
const skyGeo = new THREE.SphereGeometry(90, 32, 32);
const skyColors = [
  new THREE.Color('#2c1f3d'), // top
  new THREE.Color('#7a4a4f'), // mid
  new THREE.Color('#e0a86a')  // bottom / horizon
];
const posAttr = skyGeo.attributes.position;
const colors = [];
for (let i = 0; i < posAttr.count; i++) {
  const y = posAttr.getY(i);
  const t = THREE.MathUtils.clamp((y + 90) / 180, 0, 1);
  let c;
  if (t > 0.55) c = skyColors[0].clone().lerp(skyColors[1], (1 - (t - 0.55) / 0.45));
  else c = skyColors[1].clone().lerp(skyColors[2], 1 - t / 0.55);
  colors.push(c.r, c.g, c.b);
}
skyGeo.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));
const skyMat = new THREE.MeshBasicMaterial({ vertexColors: true, side: THREE.BackSide, fog: false });
scene.add(new THREE.Mesh(skyGeo, skyMat));

/* ---- lighting ---- */
scene.add(new THREE.AmbientLight('#5a4a55', 0.9));
const sun = new THREE.DirectionalLight('#ffcf9e', 1.6);
sun.position.set(-14, 16, 6);
sun.castShadow = true;
sun.shadow.mapSize.set(1024, 1024);
sun.shadow.camera.left = -14; sun.shadow.camera.right = 14;
sun.shadow.camera.top = 14; sun.shadow.camera.bottom = -14;
scene.add(sun);
const poolGlow = new THREE.PointLight('#7fd6d6', 3, 12, 2);
poolGlow.position.set(0, 0.6, 3);
scene.add(poolGlow);
scene.fog = new THREE.Fog('#301f2e', 26, 62);

/* ---- materials ---- */
const matStone   = new THREE.MeshStandardMaterial({ color:'#463c3f', roughness:0.9, metalness:0.05 });
const matWall    = new THREE.MeshStandardMaterial({ color:'#e9ddc8', roughness:0.75, metalness:0.02 });
const matBrass   = new THREE.MeshStandardMaterial({ color:'#c79a5f', roughness:0.35, metalness:0.85 });
const matGlass   = new THREE.MeshPhysicalMaterial({ color:'#bcd8d6', roughness:0.05, metalness:0, transmission:0.85, transparent:true, opacity:0.55 });
const matRoof    = new THREE.MeshStandardMaterial({ color:'#2f2a2f', roughness:0.65, metalness:0.15 });
const matWater   = new THREE.MeshStandardMaterial({ color:'#2fb6c2', roughness:0.15, metalness:0.3, transparent:true, opacity:0.92, emissive:'#0d5158', emissiveIntensity:0.3 });
const matSand    = new THREE.MeshStandardMaterial({ color:'#c9a97a', roughness:1 });
const matTrunk   = new THREE.MeshStandardMaterial({ color:'#5b4530', roughness:0.9 });
const matLeaf    = new THREE.MeshStandardMaterial({ color:'#2f6b45', roughness:0.7 });

const build = new THREE.Group();
scene.add(build);

/* ---- ground / platform ---- */
const ground = new THREE.Mesh(new THREE.CylinderGeometry(11, 11, 0.4, 48), matSand);
ground.position.y = -0.2;
ground.receiveShadow = true;
ground.scale.set(0.001, 1, 0.001);
build.add(ground);

/* ---- foundation ---- */
const foundation = new THREE.Mesh(new THREE.BoxGeometry(7.2, 0.5, 5.2), matStone);
foundation.position.set(0, -1.6, -1);
foundation.receiveShadow = true; foundation.castShadow = true;
build.add(foundation);
const foundationTargetY = 0.05;

/* ---- pillars ---- */
const pillarGeo = new THREE.CylinderGeometry(0.14, 0.14, 3.4, 12);
const pillarPositions = [[-3.2,-2],[3.2,-2],[-3.2,2.6],[3.2,2.6]];
const pillars = pillarPositions.map(([x,z]) => {
  const p = new THREE.Mesh(pillarGeo, matBrass);
  p.position.set(x, 12, z);
  p.castShadow = true;
  build.add(p);
  return { mesh:p, targetY: 1.8, x, z };
});

/* ---- walls (glass) ---- */
const wallGeo = new THREE.BoxGeometry(0.12, 2.6, 4.6);
const wallL = new THREE.Mesh(wallGeo, matGlass);
wallL.position.set(-16, 1.8, 0.3);
build.add(wallL);
const wallR = wallL.clone();
wallR.position.set(16, 1.8, 0.3);
build.add(wallR);

/* back wall */
const backWallGeo = new THREE.BoxGeometry(6.6, 2.6, 0.14);
const backWall = new THREE.Mesh(backWallGeo, matWall);
backWall.position.set(0, -6, -2.55);
backWall.castShadow = true; backWall.receiveShadow = true;
build.add(backWall);

/* ---- roof ---- */
const roof = new THREE.Mesh(new THREE.BoxGeometry(8, 0.3, 6), matRoof);
roof.position.set(0, 18, -0.7);
roof.castShadow = true;
build.add(roof);
const roofTrim = new THREE.Mesh(new THREE.BoxGeometry(8.3, 0.08, 6.3), matBrass);
roofTrim.position.set(0, 18, -0.7);
build.add(roofTrim);

/* ---- pool ---- */
const pool = new THREE.Mesh(new THREE.BoxGeometry(4.6, 0.12, 3.2), matWater);
pool.position.set(0.4, 0.02, 4.2);
pool.scale.set(0.001, 1, 0.001);
build.add(pool);
const poolRim = new THREE.Mesh(new THREE.BoxGeometry(5.0, 0.12, 3.6), matStone);
poolRim.position.set(0.4, -0.06, 4.2);
poolRim.scale.set(0.001, 1, 0.001);
poolRim.receiveShadow = true;
build.add(poolRim);

/* ---- loungers ---- */
const loungerGeo = new THREE.BoxGeometry(0.55, 0.12, 1.7);
const loungerPositions = [[-2.6, 6.1],[-1.6, 6.1],[2.6,6.1],[3.6,6.1]];
const loungers = loungerPositions.map(([x,z]) => {
  const l = new THREE.Mesh(loungerGeo, matWall);
  l.position.set(x, 0.3, z);
  l.scale.set(0,0,0);
  l.castShadow = true;
  build.add(l);
  return l;
});

/* ---- palm trees ---- */
function makePalm(x, z) {
  const g = new THREE.Group();
  const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.09, 0.16, 3.6, 8), matTrunk);
  trunk.position.y = 1.8;
  trunk.rotation.z = THREE.MathUtils.degToRad(6 * (Math.random() > 0.5 ? 1 : -1));
  trunk.castShadow = true;
  g.add(trunk);
  for (let i = 0; i < 6; i++) {
    const leaf = new THREE.Mesh(new THREE.ConeGeometry(0.22, 1.9, 5), matLeaf);
    leaf.position.set(0, 3.5, 0);
    leaf.rotation.z = (Math.PI / 2) - 0.35;
    leaf.rotation.y = (i / 6) * Math.PI * 2;
    leaf.translateY(0.9);
    leaf.castShadow = true;
    g.add(leaf);
  }
  g.position.set(x, 0, z);
  g.scale.set(0.001, 0.001, 0.001);
  build.add(g);
  return g;
}
const palms = [makePalm(-5.4, 3.6), makePalm(5.6, 4.6), makePalm(6.4, -2)];

/* ---- fireflies ---- */
const fireflyCount = 40;
const fireflyGeo = new THREE.BufferGeometry();
const fpos = new Float32Array(fireflyCount * 3);
for (let i = 0; i < fireflyCount; i++) {
  fpos[i*3]   = (Math.random() - 0.5) * 20;
  fpos[i*3+1] = Math.random() * 5 + 0.3;
  fpos[i*3+2] = (Math.random() - 0.5) * 16;
}
fireflyGeo.setAttribute('position', new THREE.BufferAttribute(fpos, 3));
const fireflyMat = new THREE.PointsMaterial({ color:'#ffe3a8', size:0.09, transparent:true, opacity:0, depthWrite:false });
const fireflies = new THREE.Points(fireflyGeo, fireflyMat);
scene.add(fireflies);

/* ============ BUILD TIMELINE ============ */
function playBuildSequence() {
  const tl = gsap.timeline({ delay: 0.3 });
  tl.to(ground.scale, { x:1, z:1, duration:1.1, ease:'power3.out' }, 0)
    .to(foundation.position, { y: foundationTargetY, duration:1, ease:'power3.out' }, 0.35)
    .to(backWall.position, { z:-2.55, x:0, y:1.2, duration:0.9, ease:'power2.out' }, 0.75);

  pillars.forEach((p, i) => {
    tl.to(p.mesh.position, { y: p.targetY, duration:1.1, ease:'bounce.out' }, 0.95 + i*0.12);
  });

  tl.to(wallL.position, { x:-3.55, duration:1, ease:'power3.out' }, 1.55)
    .to(wallR.position, { x:3.55, duration:1, ease:'power3.out' }, 1.55)
    .to(roof.position, { y:3.35, duration:1.15, ease:'power4.out' }, 2.15)
    .to(roofTrim.position, { y:3.35, duration:1.15, ease:'power4.out' }, 2.15)
    .to(pool.scale, { x:1, z:1, duration:0.9, ease:'power2.out' }, 2.9)
    .to(poolRim.scale, { x:1, z:1, duration:0.9, ease:'power2.out' }, 2.85);

  loungers.forEach((l, i) => {
    tl.to(l.scale, { x:1, y:1, z:1, duration:0.6, ease:'back.out(2)' }, 3.15 + i*0.08);
  });

  palms.forEach((p, i) => {
    tl.to(p.scale, { x:1, y:1, z:1, duration:0.9, ease:'elastic.out(1,0.6)' }, 3.0 + i*0.22);
  });

  tl.to(fireflyMat, { opacity:0.9, duration:1.2, ease:'power1.inOut' }, 3.6);

  return tl;
}

function resetBuild() {
  ground.scale.set(0.001,1,0.001);
  foundation.position.y = -1.6;
  backWall.position.set(0,-6,-2.55);
  pillars.forEach(p => p.mesh.position.y = 12);
  wallL.position.x = -16; wallR.position.x = 16;
  roof.position.y = 18; roofTrim.position.y = 18;
  pool.scale.set(0.001,1,0.001); poolRim.scale.set(0.001,1,0.001);
  loungers.forEach(l => l.scale.set(0,0,0));
  palms.forEach(p => p.scale.set(0.001,0.001,0.001));
  fireflyMat.opacity = 0;
}

if (reduceMotion) {
  playBuildSequence().progress(1);
} else {
  playBuildSequence();
}

document.getElementById('replayBuild').addEventListener('click', () => {
  resetBuild();
  playBuildSequence();
});

/* ============ RENDER LOOP ============ */
const clock = new THREE.Clock();
let mouseX = 0, mouseY = 0;
window.addEventListener('mousemove', (e) => {
  mouseX = (e.clientX / window.innerWidth - 0.5);
  mouseY = (e.clientY / window.innerHeight - 0.5);
});

function animate() {
  requestAnimationFrame(animate);
  const t = clock.getElapsedTime();

  if (!reduceMotion) {
    const angle = t * 0.06;
    camera.position.x = camBase.x * Math.cos(angle) - camBase.z * Math.sin(angle) + mouseX * 1.5;
    camera.position.z = camBase.x * Math.sin(angle) + camBase.z * Math.cos(angle);
    camera.position.y = camBase.y + mouseY * 0.8;
    camera.lookAt(0, 2.1, 0);

    const fpArr = fireflyGeo.attributes.position.array;
    for (let i = 0; i < fireflyCount; i++) {
      fpArr[i*3+1] += Math.sin(t*1.5 + i) * 0.0018;
    }
    fireflyGeo.attributes.position.needsUpdate = true;

    poolGlow.intensity = 2.6 + Math.sin(t * 2) * 0.4;
  }

  renderer.render(scene, camera);
}
animate();

window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});
</script>
</body>
</html>
